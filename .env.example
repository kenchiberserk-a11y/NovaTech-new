NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional isolated Hydra-compatible test endpoint. Disabled unless explicitly enabled.
# Use only in a private Vercel Preview deployment and never reuse real credentials.
LAB_LOGIN_ENABLED=false
LAB_ACCESS_TOKEN=replace-with-a-long-random-secret
LAB_ALLOWED_IP=203.0.113.10
LAB_TEST_USERNAME=lab-user
LAB_TEST_PASSWORD=replace-with-a-unique-lab-password
